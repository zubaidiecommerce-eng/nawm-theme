{% doc %}
  Eén reviewkaart uit metaobject `nawm_review`. BUILD SPEC §5.7 / §8.2.

  Harde regel: een review zonder bron-url en datum rendert niet. Die guard zit
  hier in Liquid en niet in de redactie, zodat hij niet per ongeluk overgeslagen
  kan worden. Citaten worden letterlijk overgenomen — nooit ingekort zonder dat
  zichtbaar te maken met […], nooit herschreven, nooit vertaald.

  De sterren komen per beoordeling uit het veld `sterren` en niet uit het
  gemiddelde: vijf sterren tekenen boven een driesterrenreview is precies het
  soort detail waar een lezer je op betrapt.

  @param {object} review - Metaobject nawm_review.
  @param {string} [uid] - Uniek achtervoegsel voor de sterren-clippath.
{% enddoc %}

{%- liquid
  assign quote = review.citaat.value | default: review.citaat
  assign source = review.bron.value | default: review.bron
  assign source_url = review.bron_url.value | default: review.bron_url
  assign date = review.datum.value | default: review.datum
  assign name = review.naam.value | default: review.naam
  assign title = review.titel.value | default: review.titel
  assign theme_label = review.thema.value | default: review.thema
  assign stars = review.sterren.value | default: review.sterren

  comment
    Vooraf samenstellen: Shopify past filters niet toe op argumenten van een
    render-tag.
  endcomment
  assign stars_uid = uid | default: 'review'
-%}

{%- if quote != blank and source_url != blank and date != blank -%}
  <figure class="nawm-review nawm-lift">
    <div class="nawm-review__top">
      {%- if stars != blank -%}
        <span class="nawm-review__stars">
          {% render 'pdp-stars', score: stars, id: stars_uid %}
          <span class="nawm-visually-hidden">
            {{ 'nawm.proof.stars_of_five' | t: n: stars }}
          </span>
        </span>
      {%- endif -%}

      {%- if theme_label != blank -%}
        <span class="nawm-review__theme nawm-mono">{{ theme_label }}</span>
      {%- endif -%}
    </div>

    {%- if title != blank -%}
      <p class="nawm-review__title">{{ title }}</p>
    {%- endif -%}

    <blockquote class="nawm-review__quote" cite="{{ source_url }}">{{ quote }}</blockquote>

    <figcaption class="nawm-review__meta nawm-mono">
      {%- if name != blank -%}{{ name }} · {% endif -%}
      <a href="{{ source_url }}" rel="nofollow noopener" target="_blank">
        {{- source | default: 'bron' -}}
        <span class="nawm-visually-hidden"> ({{ 'nawm.common.opens_new_tab' | t }})</span>
      </a>
      · <time datetime="{{ date | date: '%Y-%m-%d' }}">{{ date | date: '%-d %B %Y' }}</time>
    </figcaption>
  </figure>
{%- endif -%}
