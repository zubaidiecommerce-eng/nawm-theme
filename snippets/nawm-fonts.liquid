{% doc %}
  Self-hosted woff2-subsets. BUILD SPEC §3.3 / §10.2.

  Drie families, drie rollen: Fraunces (display), Inter Tight (body/UI),
  IBM Plex Mono (utility). Variable fonts als één bestand per familie — geen
  losse gewichten. Alleen de display-face wordt gepreload.

  De `assets/`-map van een Shopify-theme is plat, dus de bestanden staan direct
  in assets/ en niet in assets/fonts/. Zolang ze er nog niet zijn, staat de
  themasetting `nawm_self_hosted_fonts` uit en valt de pagina terug op de
  fallback-stacks in nawm-tokens.css. Zie docs/OPEN.md.
{% enddoc %}

{%- if settings.nawm_self_hosted_fonts -%}
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    href="{{ 'Fraunces-var.woff2' | asset_url }}"
    crossorigin
  >

  {% style %}
    @font-face {
      font-family: 'Fraunces';
      src: url({{ 'Fraunces-var.woff2' | asset_url }}) format('woff2-variations');
      font-weight: 300 700;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
    }

    @font-face {
      font-family: 'Inter Tight';
      src: url({{ 'InterTight-var.woff2' | asset_url }}) format('woff2-variations');
      font-weight: 400 600;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
    }

    @font-face {
      font-family: 'IBM Plex Mono';
      src: url({{ 'IBMPlexMono-Regular.woff2' | asset_url }}) format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+20AC, U+2122;
    }
  {% endstyle %}
{%- endif -%}
