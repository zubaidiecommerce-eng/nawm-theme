{% doc %}
  De enige knop van deze pagina. Eén vorm, twee varianten.

  Geef een product mee en de knop wordt een echte add-to-cart. Geef alleen een
  url mee en het wordt een link. Knoplabels blijven consistent door de hele
  flow (BUILD SPEC §6.2) — het label komt dus altijd uit dezelfde locale-sleutel.

  Shopify past filters niet toe op argumenten van een `render`-tag, dus geef de
  locale-sleutel door en niet `'sleutel' | t` — anders staat de ruwe sleutel op
  de knop. Zie de theme-check-regel UnsupportedFilterArguments.

  @param {string} [label_key] - Locale-sleutel van de knoptekst. Voorkeur.
  @param {string} [label] - Al vertaalde knoptekst.
  @param {string} [url] - Bestemming wanneer er geen product is meegegeven.
  @param {object} [product] - Product; maakt er een add-to-cart-formulier van.
  @param {string} [variant] - 'primary' (standaard) of 'ghost'.
  @param {boolean} [full] - Volle breedte.
  @param {string} [event] - dataLayer-event bij klik, zie §11.1.
  @param {string} [id] - Optioneel id op het klikbare element.
{% enddoc %}

{%- liquid
  comment
    Zonder bestemming wees deze knop naar #offer — een anker naar zichzelf,
    waarbij er dus niets gebeurde. Nu valt hij terug op de productpagina.
    Zie de audit, punt P0-10.
  endcomment
  assign fallback_product = settings.nawm_product
  if fallback_product.id == blank and settings.nawm_product_handle != blank
    assign fallback_product = all_products[settings.nawm_product_handle]
  endif
  assign fallback_url = fallback_product.url | default: routes.all_products_collection_url

  assign cta_text = label
  if label_key != blank
    assign cta_text = label_key | t
  endif

  assign classes = 'nawm-cta'
  if variant == 'ghost'
    assign classes = classes | append: ' nawm-cta--ghost'
  endif
  if full
    assign classes = classes | append: ' nawm-cta--full'
  endif
-%}

{%- if product != blank and product.available -%}
  {%- form 'product', product, id: id, class: 'nawm-cta-form', novalidate: 'novalidate' -%}
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
    >
    <button
      type="submit"
      name="add"
      class="{{ classes }}"
      {% if event != blank %}
        data-nawm-event="{{ event }}"
      {% endif %}
    >
      {{ cta_text }}
    </button>
  {%- endform -%}
{%- elsif product != blank -%}
  <span class="{{ classes }}" aria-disabled="true">{{ 'nawm.offer.sold_out' | t }}</span>
{%- else -%}
  <a
    class="{{ classes }}"
    href="{{ url | default: fallback_url }}"
    {% if id != blank %}
      id="{{ id }}"
    {% endif %}
    {% if event != blank %}
      data-nawm-event="{{ event }}"
    {% endif %}
  >
    {{ cta_text }}
  </a>
{%- endif -%}
