{% comment %}
  PDP-sectie: verwachtingsmanagement. Zie conversiespec v2 §2.3.

  Het bezwaar dat nergens anders op de pagina staat: "ligt dit ding over twee
  weken in een la?" Dat is een reëel bezwaar bij dit soort aankopen, en het
  wegpoetsen helpt niet.

  Deze sectie zegt eerlijk dat nacht 1 niet magisch is — en juist daardoor
  gelooft de lezer nacht 14. Zwak nacht 1 niet af.

  Let op: geen van de drie regels claimt een gezondheidsuitkomst. Ze beschrijven
  gewenning aan een apparaat. Houd dat zo; een regel als "je slaapt beter" is
  hier een build-blocker.
{% endcomment %}

{% liquid
  assign pdp_product = product
  if pdp_product == blank
    assign pdp_product = settings.nawm_product
  endif
  if pdp_product.id == blank and settings.nawm_product_handle != blank
    assign pdp_product = all_products[settings.nawm_product_handle]
  endif

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.fortnight.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.fortnight.heading' | t
  endif

  assign nights = 'n1,n2,n3' | split: ','
  assign return_days = settings.return_days | times: 1
%}

<section class="nawm-section pdp-fortnight ctx-dawn" id="eerste-weken">
  <div class="nawm-wrap">
    <div class="pdp-head pdp-head--wide nawm-reveal">
      {% render 'nawm-eyebrow', text: eyebrow %}
      <h2>{{ heading }}</h2>
    </div>

    <ol class="pdp-fortnight__steps">
      {%- for key in nights -%}
        {%- liquid
          assign base = 'nawm.pdp.fortnight.' | append: key
          assign k_label = base | append: '_label'
          assign delay = forloop.index0 | times: 80
        -%}
        <li class="pdp-fortnight__step nawm-reveal" style="--reveal-delay: {{ delay }}ms;">
          <p class="nawm-mono pdp-fortnight__label">{{ k_label | t }}</p>
          <p class="pdp-fortnight__body">{{ base | t }}</p>
        </li>
      {%- endfor -%}
    </ol>

    {%- if return_days > 0 -%}
      <p class="pdp-fortnight__closing nawm-reveal">
        {{ 'nawm.pdp.fortnight.closing' | t: days: return_days }}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pdp-fortnight__steps {
    list-style: none;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
    position: relative;
  }

  /* Dezelfde verbindende lijn als in het mechanisme: dit is ook een verloop in
     de tijd, alleen over veertien nachten in plaats van dertig minuten. */
  .pdp-fortnight__steps::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 3px;
    width: 1px;
    background: linear-gradient(180deg, var(--nawm-cool), var(--nawm-ember) 55%, var(--nawm-amber));
  }

  .pdp-fortnight__step {
    position: relative;
    padding-inline-start: var(--sp-5);
  }

  .pdp-fortnight__step::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: .5em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--nawm-amber);
  }

  .pdp-fortnight__step:first-child::before {
    background: var(--nawm-cool);
  }

  .pdp-fortnight__label {
    color: var(--nawm-ember);
    font-size: 1rem;
    letter-spacing: .1em;
  }

  .pdp-fortnight__body {
    margin-block-start: var(--sp-2);
    max-width: 46ch;
  }

  @media (min-width: 750px) {
    .pdp-fortnight__steps {
      grid-template-columns: repeat(3, 1fr);
      padding-block-start: var(--sp-5);
    }

    .pdp-fortnight__steps::before {
      inset-block: auto;
      top: 3px;
      inset-inline: 0;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--nawm-cool), var(--nawm-ember) 55%, var(--nawm-amber));
    }

    .pdp-fortnight__step {
      padding-inline-start: 0;
    }

    .pdp-fortnight__step::before {
      top: -6px;
    }
  }

  /* Twee klassen diep, en dat is nodig: `.nawm-section p` staat op (0,1,1) en
     verslaat een enkele klasse, waardoor `margin: 0` won en deze zin tegen het
     laatste tijdlijnitem plakte.

     De haarlijn erboven doet meer dan ruimte maken: hij markeert dat deze zin
     niet bij nacht 14 hoort maar bij de hele sectie. */
  .pdp-fortnight .pdp-fortnight__closing {
    margin-block-start: var(--sp-6);
    padding-block-start: var(--sp-5);
    border-block-start: 1px solid var(--line);
    max-width: 46ch;
    font-family: var(--ff-display);
    font-size: var(--fs-h3);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--fg);
    text-wrap: balance;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · PDP 2 weken",
  "settings": [
    {
      "type": "paragraph",
      "content": "Verwachtingsmanagement en risico-omkering in één. Nacht 1 zegt eerlijk dat het dan nog niet werkt — juist daardoor gelooft de lezer nacht 14. Geen enkele regel mag een gezondheidsuitkomst claimen."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Kop" }
  ],
  "presets": [{ "name": "NAWM · PDP 2 weken" }]
}
{% endschema %}
