{% comment %}
  PDP-sectie: beantwoordt B3 (nooit van dit merk gehoord — is dit troep?).
  Zie NAWM_PDP_CONVERSIE_SPEC.md §3.7.

  Deze sectie is herschreven na een storing: Shopify weigerde het bestand bij
  het synchroniseren, waardoor de productpagina live een Liquid-fout toonde en
  nul beoordelingen had. De oorzaak was een geneste `{{ }}` binnen een
  filterargument — theme-check accepteert dat, de server van Shopify niet.
  Bouw hier dus nooit een Liquid-expressie in een string.

  Drie lagen, van hard naar zacht:
    1. het cijfer met sterren en de verdeling — controleerbaar, dus eerst
    2. filterchips op thema, opgebouwd uit de thema's die er werkelijk zijn
    3. de beoordelingen zelf

  De guard zit in snippets/nawm-review-card.liquid: een beoordeling zonder
  bron-url en datum rendert niet. Kritische beoordelingen blijven staan — een
  profiel dat alleen uit vijf sterren bestaat, verlaagt de geloofwaardigheid van
  alle beoordelingen eromheen.
{% endcomment %}

{% liquid
  assign pdp_product = product
  if pdp_product == blank
    assign pdp_product = settings.nawm_product
  endif
  if pdp_product.id == blank and settings.nawm_product_handle != blank
    assign pdp_product = all_products[settings.nawm_product_handle]
  endif

  assign reviews = shop.metaobjects.nawm_review.values

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.proof.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.proof.heading' | t
  endif

  assign has_score = false
  if settings.review_score != blank and settings.review_count != blank and settings.review_checked_on != blank
    assign has_score = true
  endif

  assign distribution = settings.review_distribution | split: ','
  assign distribution_max = 0
  for value in distribution
    assign number = value | strip | times: 1
    if number > distribution_max
      assign distribution_max = number
    endif
  endfor

  assign visible = 0
  assign themes = ''
  for review in reviews
    if review.bron_url != blank and review.datum != blank and review.citaat != blank
      assign visible = visible | plus: 1
      assign theme_label = review.thema.value | default: review.thema
      if theme_label != blank
        unless themes contains theme_label
          assign themes = themes | append: theme_label | append: '|'
        endunless
      endif
    endif
  endfor
  assign theme_list = themes | split: '|'
%}

{%- if visible > 0 -%}
  <script src="{{ 'pdp-review-filter.js' | asset_url }}" type="module" fetchpriority="low"></script>
{%- endif -%}

<section class="nawm-section pdp-proof ctx-dawn" id="beoordelingen">
  <div class="nawm-wrap">
    <div class="pdp-head pdp-head--wide nawm-reveal">
      {% render 'nawm-eyebrow', text: eyebrow %}
      <h2>{{ heading }}</h2>
    </div>

    {%- if has_score -%}
      <div class="pdp-proof__summary nawm-reveal">
        <div class="pdp-proof__score-block">
          <p class="pdp-proof__score-number">{{ settings.review_score }}</p>
          <div class="pdp-proof__score-meta">
            {% render 'pdp-stars', score: settings.review_score, id: 'pdp-average' %}
            <p class="nawm-mono pdp-proof__score-line">
              {{-
                'nawm.pdp.proof.score_line'
                | t:
                  score: settings.review_score,
                  count: settings.review_count,
                  source: settings.review_source,
                  date: settings.review_checked_on
              -}}
            </p>
          </div>
        </div>

        {%- if distribution.size == 5 and distribution_max > 0 -%}
          <div class="pdp-proof__distribution">
            <h3 class="nawm-visually-hidden">{{ 'nawm.pdp.proof.distribution_label' | t }}</h3>
            <ul class="pdp-proof__bars">
              {%- for value in distribution -%}
                {%- liquid
                  assign star_level = 5 | minus: forloop.index0
                  assign count = value | strip | times: 1
                  assign width = count | times: 100 | divided_by: distribution_max
                -%}
                <li class="pdp-proof__bar-row">
                  <span class="nawm-mono pdp-proof__bar-label">
                    {{- 'nawm.proof.stars_short' | t: n: star_level -}}
                  </span>
                  <span class="pdp-proof__bar" aria-hidden="true">
                    <span class="pdp-proof__bar-fill" style="inline-size: {{ width }}%;"></span>
                  </span>
                  <span class="nawm-mono pdp-proof__bar-count">{{ count }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if visible > 0 -%}
      <div class="pdp-proof__reviews" data-pdp-reviews>
        {%- if theme_list.size > 1 -%}
          <div class="pdp-proof__filters" role="group" aria-label="{{ 'nawm.pdp.proof.filter_label' | t }}">
            <button type="button" class="nawm-chip" data-review-filter="" aria-pressed="true">
              {{ 'nawm.pdp.proof.filter_all' | t }}
            </button>
            {%- for theme_name in theme_list -%}
              <button
                type="button"
                class="nawm-chip"
                data-review-filter="{{ theme_name | escape }}"
                aria-pressed="false"
              >
                {{ theme_name }}
              </button>
            {%- endfor -%}
          </div>

          {%- comment -%}
            De teller voor schermlezers. De tekst wordt door JavaScript gevuld;
            het sjabloon staat in een los data-attribuut zonder Liquid erin.
          {%- endcomment -%}
          <p
            class="nawm-visually-hidden"
            role="status"
            data-review-status
            data-template="{{ 'nawm.pdp.proof.star_count' | t: count: '#' }}"
          ></p>
        {%- endif -%}

        <ul class="pdp-proof__list">
          {%- for review in reviews -%}
            {%- liquid
              assign quote = review.citaat.value | default: review.citaat
              assign source_url = review.bron_url.value | default: review.bron_url
              assign date = review.datum.value | default: review.datum
              assign theme_label = review.thema.value | default: review.thema
            -%}
            {%- if quote != blank and source_url != blank and date != blank -%}
              <li class="pdp-proof__card" data-review-theme="{{ theme_label | escape }}">
                {% render 'nawm-review-card', review: review, uid: forloop.index %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <p class="nawm-body pdp-proof__empty">{{ 'nawm.pdp.proof.empty' | t }}</p>
    {%- endif -%}

    <div class="pdp-proof__cta nawm-reveal">
      {% render 'pdp-buy', product: pdp_product, id: 'pdp-proof-form' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-proof__summary {
    margin-block-start: clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 750px) {
    .pdp-proof__summary {
      grid-template-columns: auto 1fr;
      gap: clamp(2rem, 5vw, 4rem);
    }
  }

  .pdp-proof__score-block {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .pdp-proof__score-number {
    font-family: var(--ff-display);
    font-variation-settings: "opsz" 96, "SOFT" 0, "WONK" 0;
    font-weight: 300;
    font-size: clamp(3rem, 2rem + 4vw, 4.5rem);
    line-height: .9;
    letter-spacing: -.03em;
    color: var(--fg);
  }

  .pdp-proof__score-meta {
    display: grid;
    gap: var(--sp-2);
  }

  .pdp-proof__score-line {
    color: var(--fg-soft);
    max-width: 36ch;
  }

  .pdp-proof__distribution {
    max-width: 26rem;
  }

  .pdp-proof__bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
  }

  .pdp-proof__bar-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr 2.5rem;
    align-items: center;
    gap: var(--sp-2);
  }

  .pdp-proof__bar-label,
  .pdp-proof__bar-count {
    color: var(--fg-soft);
  }

  .pdp-proof__bar-count {
    text-align: end;
  }

  .pdp-proof__bar {
    display: block;
    height: 8px;
    border-radius: var(--r-data);
    background: color-mix(in oklab, var(--ink-day) 10%, transparent);
    overflow: hidden;
  }

  .pdp-proof__bar-fill {
    display: block;
    height: 100%;
    background: var(--nawm-amber);
  }

  /* Zonder JS filtert er niets, en dan hoort er ook geen filterbalk te staan. */
  .pdp-proof__filters {
    display: none;
    margin-block-start: clamp(2rem, 5vw, 3rem);
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  [data-pdp-reviews].has-filters .pdp-proof__filters {
    display: flex;
  }

  .pdp-proof__list {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2rem) 0 0;
    padding: 0 var(--gutter) var(--sp-2);
    margin-inline: calc(var(--gutter) * -1);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 22rem);
    gap: var(--sp-4);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
  }

  .pdp-proof__card {
    scroll-snap-align: start;
    display: flex;
  }

  @media (min-width: 900px) {
    .pdp-proof__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      padding-inline: 0;
      margin-inline: 0;
    }
  }

  .pdp-proof__card .nawm-review {
    height: 100%;
    margin: 0;
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--nawm-dawn) 94%, #fff);
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .pdp-proof__empty {
    margin-block-start: clamp(2rem, 5vw, 3rem);
  }

  .pdp-proof__cta {
    margin-block-start: clamp(2rem, 5vw, 3rem);
    margin-inline: auto;
    max-width: 30rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · PDP beoordelingen",
  "settings": [
    {
      "type": "paragraph",
      "content": "Beoordelingen komen uit metaobject nawm_review. Zonder bron-url en datum rendert een beoordeling niet. Score, aantal, bron, controledatum en verdeling staan in de themasettings."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop"
    }
  ],
  "presets": [
    {
      "name": "NAWM · PDP beoordelingen"
    }
  ]
}
{% endschema %}
