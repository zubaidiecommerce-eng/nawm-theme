{% comment %}
  De contactpagina in het NAWM-idioom.

  Google beoordeelt hier of er een echt bedrijf achter de winkel zit, dus de
  bedrijfsgegevens staan naast het formulier en niet eronder weggestopt. Alles
  komt uit de themasettings, zodat naam, adres en KvK op elke plek van de site
  hetzelfde zijn — een verschil tussen contactpagina en footer is precies waar
  een aanvraag op strandt.

  Het formulier is Shopify's eigen contactformulier. Na versturen komt de
  bezoeker terug met een bevestiging bovenaan; die staat er in het Nederlands.
{% endcomment %}

{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.contact.heading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'nawm.contact.body' | t
  endif
%}

<section class="nawm-section nawm-contact ctx-dawn" id="contact">
  <div class="nawm-wrap nawm-contact__grid">
    <div class="nawm-contact__intro nawm-reveal">
      {%- assign contact_eyebrow = 'nawm.contact.eyebrow' | t -%}
      {% render 'nawm-eyebrow', text: contact_eyebrow %}
      <h1>{{ heading }}</h1>
      <p class="nawm-lede nawm-contact__lede">{{ body }}</p>

      <dl class="nawm-contact__details">
        {%- if settings.company_name != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.offer.company_label' | t }}</dt>
            <dd>{{ settings.company_name }}</dd>
          </div>
        {%- endif -%}

        {%- if settings.company_city != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.contact.address_label' | t }}</dt>
            <dd>{{ settings.company_city }}</dd>
          </div>
        {%- endif -%}

        {%- if settings.kvk_number != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.pdp.brand.kvk_label' | t }}</dt>
            <dd class="nawm-mono">{{ settings.kvk_number }}</dd>
          </div>
        {%- endif -%}

        {%- if settings.vat_number != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.pdp.brand.vat_label' | t }}</dt>
            <dd class="nawm-mono">{{ settings.vat_number }}</dd>
          </div>
        {%- endif -%}

        {%- if settings.support_email != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.pdp.brand.email_label' | t }}</dt>
            <dd><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></dd>
          </div>
        {%- endif -%}

        {%- if settings.support_response_time != blank -%}
          <div class="nawm-contact__detail">
            <dt>{{ 'nawm.contact.response_label' | t }}</dt>
            <dd>{{ settings.support_response_time }}</dd>
          </div>
        {%- endif -%}
      </dl>

      {%- comment -%}
        Waarom er geen telefoonnummer staat. Het weglaten zonder uitleg leest
        als iets verbergen; het benoemen leest als een keuze.
      {%- endcomment -%}
      <p class="nawm-small nawm-contact__note">{{ 'nawm.contact.no_phone' | t }}</p>
    </div>

    <div class="nawm-card nawm-contact__form-card nawm-reveal" style="--reveal-delay: 80ms;">
      {%- form 'contact', id: 'nawm-contact-form', class: 'nawm-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="nawm-contact__success" role="status">{{ 'nawm.contact.success' | t }}</p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="nawm-contact__error" role="alert">{{ 'nawm.contact.error' | t }}</p>
        {%- endif -%}

        <div class="nawm-contact__field">
          <label for="nawm-contact-name">{{ 'nawm.contact.name_label' | t }}</label>
          <input
            id="nawm-contact-name"
            type="text"
            name="contact[name]"
            autocomplete="name"
            value="{{ form.name }}"
          >
        </div>

        <div class="nawm-contact__field">
          <label for="nawm-contact-email">{{ 'nawm.contact.email_label' | t }}</label>
          <input
            id="nawm-contact-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            value="{{ form.email }}"
          >
        </div>

        <div class="nawm-contact__field">
          <label for="nawm-contact-order">{{ 'nawm.contact.order_label' | t }}</label>
          <input id="nawm-contact-order" type="text" name="contact[Bestelnummer]">
        </div>

        <div class="nawm-contact__field">
          <label for="nawm-contact-body">{{ 'nawm.contact.message_label' | t }}</label>
          <textarea id="nawm-contact-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="nawm-cta nawm-cta--full">{{ 'nawm.contact.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .nawm-contact__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .nawm-contact__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nawm-contact .nawm-contact__lede {
    margin-block-start: var(--sp-4);
  }

  .nawm-contact__details {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 600px) {
    .nawm-contact__details {
      grid-template-columns: 1fr 1fr;
    }
  }

  .nawm-contact__detail dt {
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    text-transform: uppercase;
    letter-spacing: .14em;
    color: var(--fg-soft);
  }

  .nawm-contact__detail dd {
    margin: var(--sp-1) 0 0;
    color: var(--fg);
  }

  .nawm-contact__note {
    margin-block-start: clamp(1.5rem, 4vw, 2rem);
    max-width: 52ch;
  }

  .nawm-contact__form-card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .nawm-contact__form {
    display: grid;
    gap: var(--sp-4);
    margin: 0;
  }

  .nawm-contact__field {
    display: grid;
    gap: var(--sp-1);
  }

  .nawm-contact__field label {
    font-size: var(--fs-small);
    color: var(--fg-soft);
  }

  .nawm-contact__field input,
  .nawm-contact__field textarea {
    width: 100%;
    min-height: 52px;
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid color-mix(in oklab, var(--ink-day) 22%, transparent);
    border-radius: var(--r-data);
    background: #fff;
    color: var(--ink-day);
    font-family: var(--ff-body);
    font-size: 1rem;
  }

  .nawm-contact__field textarea {
    min-height: auto;
    resize: vertical;
    line-height: 1.5;
  }

  .nawm-contact__success,
  .nawm-contact__error {
    margin: 0;
    padding: var(--sp-3);
    border-radius: var(--r-data);
    font-size: var(--fs-small);
  }

  .nawm-contact__success {
    border: 1px solid var(--nawm-amber);
    background: color-mix(in oklab, var(--nawm-amber) 18%, var(--nawm-dawn));
    color: var(--ink-day);
  }

  .nawm-contact__error {
    border: 1px solid var(--nawm-ember);
    color: var(--nawm-ember);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · Contact",
  "settings": [
    {
      "type": "paragraph",
      "content": "Bedrijfsnaam, adres, KvK, btw, e-mail en reactietijd komen uit de themasettings, zodat ze overal op de site identiek zijn."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Tekst"
    }
  ],
  "presets": [
    {
      "name": "NAWM · Contact"
    }
  ]
}
{% endschema %}
