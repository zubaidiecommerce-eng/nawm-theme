{% comment %}
  De vertrouwensrij: zes concrete redenen waarom bestellen bij een onbekend
  merk veilig is.

  Elk item is controleerbaar en komt uit de themasettings of uit een feit dat
  Mohammed heeft bevestigd. Wat er níét in staat is net zo belangrijk:

    · geen generieke "100% kwaliteit"-badges — die verlagen het vertrouwen
    · geen keurmerken die niet zijn afgegeven. Staat er CE of RoHS op de
      verpakking, dan hoort dat hier thuis; tot dat bevestigd is, staat het er
      niet. Zie docs/OPEN-PDP.md.

  Het klantenaantal komt uit de bol-verkopen en staat er mét die bron bij. Een
  kaal "12.000 klanten" zonder herkomst is precies de claim waar de spec voor
  waarschuwt.
{% endcomment %}

{% liquid
  assign return_days = settings.return_days | times: 1
  assign warranty_years = settings.warranty_years | times: 1

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.trust.heading' | t
  endif
%}

<section class="nawm-section nawm-trust ctx-dawn" id="waarborgen">
  <div class="nawm-wrap">
    <h2 class="nawm-visually-hidden">{{ heading }}</h2>

    <ul class="nawm-trust__list">
      {%- comment -%}
        Geen klantenaantal: dat was niet te controleren en valt onder Google's
        Misrepresentation-beleid. Wat er staat komt uit de bol-listing en is met
        één klik na te rekenen.
      {%- endcomment -%}
      {%- if section.settings.show_customer_count
        and settings.review_score != blank
        and settings.review_count != blank
      -%}
        <li class="nawm-trust__item nawm-lift nawm-reveal">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M9 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6M16 5.2a3.5 3.5 0 010 6.6M17.5 14.2c2.4.6 4 2.6 4 5.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>
            {{-
              'nawm.trust.customers'
              | t: score: settings.review_score, count: settings.review_count, source: settings.review_source
            -}}
          </span>
        </li>
      {%- endif -%}

      {%- if return_days > 0 -%}
        <li class="nawm-trust__item nawm-lift nawm-reveal" style="--reveal-delay: 60ms;">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M4 10h11a4.5 4.5 0 110 9H9M4 10l4-4M4 10l4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{{ 'nawm.trust.returns' | t: days: return_days }}</span>
        </li>
      {%- endif -%}

      {%- if warranty_years > 0 -%}
        <li class="nawm-trust__item nawm-lift nawm-reveal" style="--reveal-delay: 120ms;">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M12 2.8l7.2 2.6v6c0 4.8-3.1 8-7.2 9.4C7.9 19.4 4.8 16.2 4.8 11.4v-6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M8.8 11.8l2.3 2.3 4.3-4.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>{{ 'nawm.trust.warranty' | t: years: warranty_years }}</span>
        </li>
      {%- endif -%}

      {%- if settings.support_response_time != blank -%}
        <li class="nawm-trust__item nawm-lift nawm-reveal" style="--reveal-delay: 180ms;">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M3.5 5.5h17v11h-9l-5 3.5v-3.5h-3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          </svg>
          <span>{{ 'nawm.trust.support' | t: time: settings.support_response_time }}</span>
        </li>
      {%- endif -%}

      <li class="nawm-trust__item nawm-lift nawm-reveal" style="--reveal-delay: 240ms;">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <rect x="4" y="10.5" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path d="M8 10.5V7.8a4 4 0 018 0v2.7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span>{{ 'nawm.trust.payment' | t }}</span>
      </li>

      <li class="nawm-trust__item nawm-lift nawm-reveal" style="--reveal-delay: 300ms;">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M4.5 3.5h11l4 4v13h-15z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
          <path d="M15 3.5v4.5h4.5M8 12h8M8 15.5h8M8 8.5h3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span>{{ 'nawm.trust.dutch' | t }}</span>
      </li>

    </ul>
  </div>
</section>

{% stylesheet %}
  .nawm-trust {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .nawm-trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 600px) {
    .nawm-trust__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .nawm-trust__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .nawm-trust__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: center;
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--nawm-dawn) 94%, #fff);
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--fg);
  }

  .nawm-trust__item svg {
    flex: none;
    color: var(--nawm-ember);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · Waarborgen",
  "settings": [
    {
      "type": "paragraph",
      "content": "Alleen waarborgen die je kunt waarmaken. Geen generieke kwaliteitsbadges en geen keurmerken die niet zijn afgegeven — die verlagen het vertrouwen in plaats van het te verhogen."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop voor schermlezers"
    },
    {
      "type": "checkbox",
      "id": "show_customer_count",
      "label": "Reviewcijfer tonen",
      "default": true,
      "info": "Toont score, aantal en bron uit de themasettings. Staat een van de drie leeg, dan blijft het blok weg."
    }
  ],
  "presets": [
    {
      "name": "NAWM · Waarborgen"
    }
  ]
}
{% endschema %}
