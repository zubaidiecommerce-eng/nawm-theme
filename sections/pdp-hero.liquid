{% comment %}
  PDP-sectie: het koopblok. Instap voor de hele pagina.
  Zie NAWM_PDP_CONVERSIE_SPEC.md §3.1.

  Binnen één scherm moet hier staan wat het is, waarom het beter is en waarom
  deze bezoeker het nodig heeft — plus prijs, beschikbaarheid en één dominante
  koopknop.

  Twee dingen die makkelijk misgaan en hier bewust zijn vastgelegd:

  · De galerij is op mobiel maximaal 62vh. Groter duwt de kop en de USP's onder
    de vouw, en dat is de duurste fout op deze pagina.
  · Elke USP-bullet volgt voordeel → kenmerk → bewijs, en elk bewijs is een
    link naar de plek waar het waargemaakt wordt. Een bullet zonder verankering
    is een claim; een bullet mét is een belofte die je kunt controleren.

  Shopify's dynamic checkout buttons staan uit — zie snippets/pdp-buy.liquid.
{% endcomment %}

{% liquid
  assign pdp_product = product
  if pdp_product == blank
    assign pdp_product = settings.nawm_product
  endif

  comment
    Vangnet voor de productkoppeling. Een `product`-themasetting levert normaal
    een productobject op, maar staat hij leeg of verkeerd ingevuld, dan valt
    alles wat eraan hangt stil: prijs, specificaties en de knoptekst. De handle
    is de tweede weg naar hetzelfde product en kost niets.
  endcomment
  if pdp_product.id == blank and settings.nawm_product_handle != blank
    assign pdp_product = all_products[settings.nawm_product_handle]
  endif

  assign images = pdp_product.images
  assign variant = pdp_product.selected_or_first_available_variant

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.hero.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.hero.heading' | t
  endif
  assign heading_lines = heading | split: '|'

  assign subheading = section.settings.subheading
  if subheading == blank
    assign subheading = 'nawm.pdp.hero.subheading' | t
  endif

  comment
    De vier beelden uit de beeldbrief (§9). Zolang ze nog niet aan het product
    hangen, rendert elke slide een zichtbare placeholder met de bestandsnaam
    erin, zodat een lege plek nooit stilletjes doorschuift.
  endcomment
  assign placeholder_slugs = 'hero-recht-van-voren,hero-schuin-van-boven,hero-achterkant,avond-donkere-kamer,hero-schaalgevoel' | split: ','
  assign placeholder_alts = 'front,angle,back,dark,scale' | split: ','

  comment
    De galerij toont maximaal zes beelden. Het aantal slides, de indicator en
    de thumbnails lezen alle drie dit ene getal, zodat "afbeelding 7 van 8"
    nooit kan verwijzen naar een slide die er niet is.
  endcomment
  assign slide_count = images.size
  if slide_count == 0
    assign slide_count = placeholder_slugs.size
  elsif slide_count > 6
    assign slide_count = 6
  endif

  assign return_days = settings.return_days | times: 1
  assign warranty_years = settings.warranty_years | times: 1

  assign brightness = pdp_product.metafields.nawm.brightness_levels.value
  assign sunrise_min = pdp_product.metafields.nawm.sunrise_min_minutes.value | default: 10
  assign sunrise_max = pdp_product.metafields.nawm.sunrise_max_minutes.value | default: 60
  assign wake_sounds = pdp_product.metafields.nawm.wake_sounds_count.value
  assign manual = pdp_product.metafields.nawm.manual_pdf

  capture delivery_date
    render 'pdp-delivery-date'
  endcapture
%}

{% render 'nawm-manual-gate', manual: manual %}

<script src="{{ 'pdp-gallery.js' | asset_url }}" type="module" fetchpriority="low"></script>
<script src="{{ 'pdp-sticky-cta.js' | asset_url }}" type="module" fetchpriority="low"></script>

<section
  class="nawm-section pdp-hero ctx-dawn"
  id="koopblok"
  data-nawm-pdp
>
  <div class="nawm-wrap pdp-hero__grid">
    {%- comment -%} ---------------------------------------------------- galerij {%- endcomment -%}
    <div class="pdp-gallery" data-pdp-gallery>
      <div
        class="pdp-gallery__track"
        data-gallery-track
        role="region"
        tabindex="0"
        aria-label="{{ 'nawm.pdp.hero.gallery_label' | t }}"
      >
        {%- if images.size > 0 -%}
          {%- for image in images limit: 6 -%}
            {%- comment -%}
              De alt-tekst wordt vooraf samengesteld: Shopify past filters niet
              toe op argumenten van een render-tag.
            {%- endcomment -%}
            {%- assign image_alt = image.alt | default: pdp_product.title -%}
            <div class="pdp-gallery__slide" data-gallery-slide tabindex="-1">
              {% render 'nawm-figure',
                image: image,
                alt: image_alt,
                sizes: '(min-width: 1024px) 46vw, 100vw',
                eager: forloop.first,
                class: 'pdp-gallery__figure'
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for slug in placeholder_slugs -%}
            {%- liquid
              assign alt_key = 'nawm.pdp.hero.image_alt.' | append: placeholder_alts[forloop.index0]
              assign alt_text = alt_key | t
            -%}
            <div class="pdp-gallery__slide" data-gallery-slide tabindex="-1">
              {% render 'nawm-figure',
                slug: slug,
                alt: alt_text,
                ratio: '4 / 5',
                class: 'pdp-gallery__figure'
              %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- if slide_count > 1 -%}
        <p class="nawm-mono pdp-gallery__position">
          {{-
            'nawm.pdp.hero.gallery_position'
            | t: index: '<span data-gallery-position>1</span>', total: slide_count
          -}}
        </p>

        <ul class="pdp-gallery__thumbs">
          {%- for index in (1..slide_count) -%}
            <li>
              <button
                type="button"
                class="pdp-gallery__thumb"
                data-gallery-thumb
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {%- if images.size > 0 -%}
                  {{
                    images[forloop.index0]
                    | image_url: width: 160
                    | image_tag: widths: '80,160', sizes: '80px', alt: '', loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="pdp-gallery__thumb-blank" aria-hidden="true">{{ forloop.index }}</span>
                {%- endif -%}
                <span class="nawm-visually-hidden">
                  {{ 'nawm.pdp.hero.gallery_thumb' | t: index: forloop.index }}
                </span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} --------------------------------------------------- koopblok {%- endcomment -%}
    <div class="pdp-hero__buy">
      <div class="pdp-hero__buy-inner">
        {% render 'nawm-eyebrow', text: eyebrow %}

        <h1 class="pdp-hero__heading">
          {%- for line in heading_lines -%}
            <span class="pdp-hero__heading-line">{{ line }}</span>
          {%- endfor -%}
        </h1>

        <p class="nawm-lede pdp-hero__sub">{{ subheading }}</p>

        {%- if settings.review_score != blank and settings.review_count != blank -%}
          <a class="pdp-hero__rating" href="#beoordelingen">
            {% render 'pdp-stars', score: settings.review_score, id: 'pdp-hero-stars' %}
            <span class="nawm-mono">
              {{-
                'nawm.pdp.hero.rating'
                | t: score: settings.review_score, count: settings.review_count
              -}}
            </span>
          </a>
        {%- endif -%}

        <p class="pdp-hero__price">
          {% render 'nawm-price', product: pdp_product %}
        </p>

        <ul class="pdp-hero__usps" aria-label="{{ 'nawm.pdp.hero.usp_label' | t }}">
          <li>
            <strong>{{ 'nawm.pdp.hero.usp.u1.benefit' | t }}</strong>
            <span class="pdp-hero__usp-feature">
              {%- if brightness != blank -%}
                {{-
                  'nawm.pdp.hero.usp.u1.feature'
                  | t: min: sunrise_min, max: sunrise_max, levels: brightness
                -}}
              {%- else -%}
                {% render 'nawm-verify',
                  field: 'brightness_levels',
                  note: 'aantal helderheidsstanden op het verkoopmodel'
                %}
              {%- endif -%}
            </span>
            <a class="pdp-hero__usp-proof" href="#demo">{{ 'nawm.pdp.hero.usp.u1.proof' | t }}</a>
          </li>

          <li>
            <strong>{{ 'nawm.pdp.hero.usp.u2.benefit' | t }}</strong>
            <span class="pdp-hero__usp-feature">{{ 'nawm.pdp.hero.usp.u2.feature' | t }}</span>
            {%- if wake_sounds != blank -%}
              <a class="pdp-hero__usp-proof" href="#specificaties">
                {{- 'nawm.pdp.hero.usp.u2.proof' | t: count: wake_sounds -}}
              </a>
            {%- else -%}
              <span class="pdp-hero__usp-proof">
                {% render 'nawm-verify',
                  field: 'wake_sounds_count',
                  note: 'aantal selecteerbare wekgeluiden — fysieke test van het verkoopmodel'
                %}
              </span>
            {%- endif -%}
          </li>

          <li>
            <strong>{{ 'nawm.pdp.hero.usp.u3.benefit' | t }}</strong>
            <span class="pdp-hero__usp-feature">{{ 'nawm.pdp.hero.usp.u3.feature' | t }}</span>
            <a class="pdp-hero__usp-proof" href="#avond">{{ 'nawm.pdp.hero.usp.u3.proof' | t }}</a>
          </li>

          <li>
            <strong>{{ 'nawm.pdp.hero.usp.u4.benefit' | t }}</strong>
            <span class="pdp-hero__usp-feature">{{ 'nawm.pdp.hero.usp.u4.feature' | t }}</span>
            {%- if manual.value != blank -%}
              <a
                class="pdp-hero__usp-proof"
                href="{{ manual.value.url }}"
                data-nawm-event="open_manual"
                data-nawm-manual
                target="_blank"
                rel="noopener"
              >
                {{- 'nawm.pdp.hero.usp.u4.proof' | t -}}
                <span class="nawm-visually-hidden"> ({{ 'nawm.common.opens_new_tab' | t }})</span>
              </a>
            {%- else -%}
              <span class="pdp-hero__usp-proof">
                {% render 'nawm-verify', field: 'manual_pdf', note: 'Nederlandstalige handleiding als PDF' %}
              </span>
            {%- endif -%}
          </li>
        </ul>

        {%- comment -%}
          Het anker waar de mobiele koopbalk op let. Het staat om de knop heen
          en niet erin, zodat de observer niet meebeweegt met het formulier.
        {%- endcomment -%}
        <div class="pdp-hero__cta" data-pdp-hero-cta>
          {% render 'pdp-buy', product: pdp_product, id: 'pdp-hero-form', shipping: true %}
        </div>

        {%- comment -%}
          Voorraad alleen wanneer hij daadwerkelijk bijgehouden wordt en onder
          de drempel zit. Een verzonnen aantal is een misleidende handelspraktijk
          en kost precies het vertrouwen dat de rest van de pagina opbouwt.
        {%- endcomment -%}
        {%- if settings.show_stock_notice
          and variant.inventory_management != blank
          and variant.inventory_quantity > 0
          and variant.inventory_quantity <= settings.stock_threshold
        -%}
          <p class="nawm-mono pdp-hero__stock">
            {{ 'nawm.pdp.hero.stock_low' | t: count: variant.inventory_quantity }}
          </p>
        {%- endif -%}

        <ul class="pdp-hero__guarantee">
          <li>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                d="M4 8h9a4 4 0 010 8H8M4 8l3-3M4 8l3 3"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {%- if return_days > 0 -%}
              {{ 'nawm.pdp.common.returns_days' | t: days: return_days }}
            {%- else -%}
              {% render 'nawm-verify', field: 'return_days', note: 'retourtermijn in dagen' %}
            {%- endif -%}
          </li>
          <li>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                d="M10 2.5l6 2.2v5c0 4-2.6 6.7-6 7.8-3.4-1.1-6-3.8-6-7.8v-5z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
            {%- if warranty_years > 0 -%}
              {{ 'nawm.pdp.common.warranty_years' | t: years: warranty_years }}
            {%- else -%}
              {% render 'nawm-verify', field: 'warranty_years', note: 'garantietermijn — identiek aan verpakking en bol-listing' %}
            {%- endif -%}
          </li>
          <li>
            <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                d="M3.5 4.5h13v9h-7l-4 3v-3h-2z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"
              />
            </svg>
            {{ 'nawm.pdp.common.support_nl' | t }}
          </li>
        </ul>

        {%- comment -%}
          De besteldeadline erbij maakt deze regel iets anders dan de microcopy
          onder de knop: daar staat de datum, hier staat ook tot hoe laat je
          erover kunt doen. Zonder deadline zou hij de microcopy herhalen, en
          dan blijft hij weg.
        {%- endcomment -%}
        {%- if settings.order_deadline_time != blank and delivery_date != blank -%}
          <p class="nawm-small pdp-hero__delivery">
            {{
              'nawm.pdp.hero.delivery'
              | t: time: settings.order_deadline_time, date: delivery_date
            }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- comment -%}
  De mobiele koopbalk staat één keer op de pagina en hangt aan de hero, omdat
  hij op de hero-CTA let. PDP SPEC §4.1.
{%- endcomment -%}
<div class="pdp-sticky" data-pdp-sticky inert>
  <p class="pdp-sticky__meta">
    <span class="pdp-sticky__name">{{ pdp_product.title | default: shop.name }}</span>
    <span class="pdp-sticky__price">{% render 'nawm-price', product: pdp_product %}</span>
  </p>
  {% render 'pdp-buy',
    product: pdp_product,
    id: 'pdp-sticky-form',
    microcopy: false,
    short: true
  %}
</div>

{%- if pdp_product != blank -%}
  {%- comment -%}
    Product-structured data komt uit Shopify zelf en nooit met de hand
    samengesteld, zodat prijs en beschikbaarheid niet uit elkaar kunnen lopen.
  {%- endcomment -%}
  <script type="application/ld+json">
    {{ pdp_product | structured_data }}
  </script>
{%- endif -%}

{% stylesheet %}
  .pdp-hero {
    /* De hero draagt de knop; de sectiepadding erboven mag hem niet wegduwen. */
    padding-block-start: clamp(2rem, 5vw, 4rem);
  }

  .pdp-hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 1024px) {
    .pdp-hero__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: clamp(2.5rem, 4vw, 4.5rem);
    }
  }

  /* ------------------------------------------------------------- galerij */

  .pdp-gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: var(--sp-2);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--r-card);
  }

  .pdp-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .pdp-gallery__slide {
    scroll-snap-align: start;
    /* Boven 62vh duwt de galerij de kop en de USP's onder de vouw. */
    max-height: 62vh;
  }

  .pdp-gallery__slide:focus-visible {
    outline: 2px solid var(--nawm-amber);
    outline-offset: 3px;
  }

  .pdp-gallery__figure img,
  .pdp-gallery__figure .nawm-figure__placeholder {
    max-height: 62vh;
    object-fit: cover;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .pdp-gallery__slide,
    .pdp-gallery__figure img,
    .pdp-gallery__figure .nawm-figure__placeholder {
      max-height: none;
    }
  }

  .pdp-gallery__position {
    margin-block-start: var(--sp-3);
    color: var(--fg-soft);
  }

  .pdp-gallery__thumbs {
    list-style: none;
    margin: var(--sp-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .pdp-gallery__thumb {
    display: block;
    width: 64px;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-data);
    background: var(--nawm-indigo);
    cursor: pointer;
    overflow: hidden;
  }

  .pdp-gallery__thumb[aria-current="true"] {
    border-color: var(--nawm-amber);
    box-shadow: 0 0 0 1px var(--nawm-amber);
  }

  .pdp-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp-gallery__thumb-blank {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    color: var(--ink-night-soft);
  }

  @media (min-width: 1024px) {
    .pdp-gallery__thumb {
      width: 84px;
    }
  }

  /* ------------------------------------------------------------ koopblok */

  @media (min-width: 1024px) {
    /* Het koopblok loopt mee terwijl je door de galerij scrollt. */
    .pdp-hero__buy-inner {
      position: sticky;
      top: calc(var(--header-height, 60px) + var(--sp-4));
    }
  }

  .pdp-hero__heading {
    margin-block-start: var(--sp-2);
  }

  .pdp-hero__heading-line {
    display: block;
  }

  .pdp-hero__sub {
    margin-block-start: var(--sp-4);
    max-width: 46ch;
  }

  .pdp-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-block-start: var(--sp-4);
    color: var(--fg);
    text-decoration: none;
    border-block-end: 1px solid var(--line);
    padding-block-end: 2px;
  }

  .pdp-hero__rating:hover {
    border-block-end-color: var(--nawm-amber);
  }

  .pdp-hero__price {
    margin-block-start: var(--sp-4);
    font-family: var(--ff-mono);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .pdp-hero__usps {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .pdp-hero__usps li {
    display: grid;
    gap: 2px;
    padding-inline-start: var(--sp-4);
    position: relative;
  }

  .pdp-hero__usps li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: .62em;
    width: 8px;
    height: 1px;
    background: var(--nawm-amber);
  }

  .pdp-hero__usps strong {
    font-weight: 500;
    color: var(--fg);
  }

  .pdp-hero__usp-feature {
    font-size: var(--fs-small);
    color: var(--fg-soft);
  }

  .pdp-hero__usp-proof {
    justify-self: start;
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    letter-spacing: .04em;
    color: var(--nawm-amber);
    text-decoration: none;
    border-block-end: 1px solid currentColor;
  }

  .ctx-dawn .pdp-hero__usp-proof {
    color: var(--nawm-ember);
  }

  .pdp-hero__cta {
    margin-block-start: var(--sp-5);
  }

  .pdp-hero__stock {
    margin-block-start: var(--sp-3);
    color: var(--nawm-amber);
  }

  .pdp-hero__guarantee {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    font-size: var(--fs-small);
    color: var(--fg-soft);
  }

  .pdp-hero__guarantee li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .pdp-hero__guarantee li + li::before {
    content: "·";
    margin-inline-end: var(--sp-2);
  }

  .pdp-hero__guarantee svg {
    flex: none;
    color: var(--nawm-amber);
  }

  .pdp-hero__delivery {
    margin-block-start: var(--sp-3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · PDP koopblok",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prijs, voorraad, levertijd, retour en garantie komen uit het product en de themasettings. Laat kop en tekst leeg om de copy uit locales/nl.default.json te gebruiken."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop",
      "info": "Een | markeert een regelovergang."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subkop",
      "info": "Maximaal twee regels."
    }
  ],
  "presets": [
    {
      "name": "NAWM · PDP koopblok"
    }
  ]
}
{% endschema %}
