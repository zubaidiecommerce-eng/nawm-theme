{% comment %}
  PDP-sectie: beantwoordt B1 (werkt dit echt, of is het een duur nachtlampje?).
  Zie NAWM_PDP_CONVERSIE_SPEC.md §3.2.

  Iemand die niet begrijpt wáárom iets zou werken, gelooft niet dat het werkt.
  Daarom staat het mechanisme vóór de features.

  Drie kloktijden op één verbindende lijn die van koel naar amber verloopt.
  Geen kaarten, geen icoontjes-op-een-rij, en geen 01/02/03 — het zijn echte
  momenten op een echte klok.

  Anders dan op de landingspagina staat deze sectie in het licht. De
  productpagina vertelt geen nacht; hij beantwoordt één vraag na de andere, en
  dat leest beter op een lichte ondergrond.

  Wat hier bewust NIET staat: geen melatoninegrafiek, geen slaapfases, geen
  cortisol, en geen enkele verwijzing naar bewijs uit onderzoek. Het mechanisme
  is fysiek en zichtbaar; dat is genoeg, en het is het enige wat waargemaakt
  kan worden. Zie de verboden categorie in BUILD SPEC §7.1.
{% endcomment %}

{% liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.mechanism.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.mechanism.heading' | t
  endif

  assign body = section.settings.body
  if body == blank
    assign body = 'nawm.pdp.mechanism.body' | t
  endif

  assign steps = 's1,s2,s3' | split: ','
%}

<section class="nawm-section pdp-mechanism ctx-dawn" id="mechanisme">
  <div class="nawm-wrap">
    <div class="pdp-head pdp-head--wide nawm-reveal">
      {% render 'nawm-eyebrow', text: eyebrow %}
      <h2>{{ heading }}</h2>
      <p class="nawm-body">{{ body }}</p>
    </div>

    <ol class="pdp-mechanism__steps">
      {%- for key in steps -%}
        {%- liquid
          assign base = 'nawm.pdp.mechanism.steps.' | append: key
          assign k_time = base | append: '.time'
          assign k_title = base | append: '.title'
          assign k_body = base | append: '.body'
          assign delay = forloop.index0 | times: 80
        -%}
        {%- liquid
          assign clip_key = 'clip_' | append: key
          assign step_clip = section.settings[clip_key]
          assign poster_key = 'clip_' | append: key | append: '_poster'
          assign step_poster = section.settings[poster_key]
        -%}
        <li class="pdp-mechanism__step nawm-reveal" style="--reveal-delay: {{ delay }}ms;">
          <p class="nawm-mono pdp-mechanism__time">{{ k_time | t }}</p>

          {%- comment -%}
            De clip staat tussen de tijd en de tekst: je ziet eerst hoe laat het
            is, dan wat er gebeurt, dan waarom. Ontbreekt hij, dan schuift de
            tekst gewoon omhoog.
          {%- endcomment -%}
          {%- if step_clip != blank -%}
            <div class="pdp-mechanism__step-clip">
              {% render 'nawm-clip',
                video: step_clip,
                poster: step_poster,
                ratio: '4 / 3',
                kind: 'recording'
              %}
            </div>
          {%- endif -%}

          <h3 class="pdp-mechanism__title">{{ k_title | t }}</h3>
          <p class="pdp-mechanism__body">{{ k_body | t }}</p>
        </li>
      {%- endfor -%}
    </ol>

    {%- comment -%}
      Twee regels tegenover elkaar. Het contrast doet het argument, dus er
      hoort geen derde regel bij en geen toelichting onder.
    {%- endcomment -%}

    <div class="pdp-mechanism__contrast nawm-reveal">
      <p class="pdp-mechanism__old">{{ 'nawm.pdp.mechanism.old_way' | t }}</p>
      <p class="pdp-mechanism__new">{{ 'nawm.pdp.mechanism.new_way' | t }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-mechanism__steps {
    list-style: none;
    counter-reset: none;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
    position: relative;
  }

  /* De verbindende lijn loopt van koel telefoonlicht naar amber daglicht. Op
     mobiel staat hij verticaal langs de tijden, op desktop horizontaal erboven. */
  .pdp-mechanism__steps::before {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-start: 3px;
    width: 1px;
    background: linear-gradient(180deg, var(--nawm-cool), var(--nawm-ember) 55%, var(--nawm-amber));
  }

  .pdp-mechanism__step {
    padding-inline-start: var(--sp-5);
    position: relative;
  }

  .pdp-mechanism__step::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: .5em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--nawm-amber);
  }

  .pdp-mechanism__step:first-child::before {
    background: var(--nawm-cool);
  }

  .pdp-mechanism__time {
    color: var(--nawm-amber);
    font-size: 1rem;
    letter-spacing: .08em;
  }

  /* De clip krijgt een vaste verhouding, zodat de drie kolommen op desktop
     even hoog blijven ook als er maar één clip staat. */
  .pdp-mechanism__step-clip {
    margin-block: var(--sp-3);
  }

  .pdp-mechanism__title {
    margin-block-start: var(--sp-1);
  }

  .pdp-mechanism__body {
    margin-block-start: var(--sp-2);
    max-width: 44ch;
  }

  @media (min-width: 750px) {
    .pdp-mechanism__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-5);
      padding-block-start: var(--sp-5);
    }

    .pdp-mechanism__steps::before {
      inset-block: auto;
      top: 3px;
      inset-inline: 0;
      width: auto;
      height: 1px;
      background: linear-gradient(90deg, var(--nawm-cool), var(--nawm-ember) 55%, var(--nawm-amber));
    }

    .pdp-mechanism__step {
      padding-inline-start: 0;
    }

    .pdp-mechanism__step::before {
      top: -6px;
      inset-inline-start: 0;
    }
  }

  .pdp-mechanism__contrast {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--line);
    display: grid;
    gap: var(--sp-2);
    max-width: 52ch;
  }

  .pdp-mechanism__old {
    color: var(--nawm-cool);
  }

  .pdp-mechanism__new {
    color: var(--nawm-amber);
  }

  .pdp-mechanism__contrast p {
    font-size: var(--fs-h3);
    line-height: 1.3;
    letter-spacing: -.01em;
  }
{% endstylesheet %}

