{% comment %}
  PDP-sectie: beantwoordt B6 (is dit ingewikkeld om in te stellen?).
  Zie NAWM_PDP_CONVERSIE_SPEC.md §3.5.

  Vier stappen, 2×2 op desktop, gestapeld op mobiel. Mono-tijdstempel per
  kaart, geen icoon.

  Onderaan het ongebruikelijke stuk: de handleiding vóór de koop weggeven.
  Bestaande reviews in deze categorie klagen structureel over onbegrijpelijke
  handleidingen. Door hem vooraf te tonen draait het grootste categoriebezwaar
  om in het sterkste vertrouwenssignaal. Ontbreekt de PDF, dan staat er een
  VERIFY en geen dode link.
{% endcomment %}

{% liquid
  assign pdp_product = product
  if pdp_product == blank
    assign pdp_product = settings.nawm_product
  endif

  comment
    Vangnet voor de productkoppeling. Een `product`-themasetting levert normaal
    een productobject op, maar staat hij leeg of verkeerd ingevuld, dan valt
    alles wat eraan hangt stil: prijs, specificaties en de knoptekst. De handle
    is de tweede weg naar hetzelfde product en kost niets.
  endcomment
  if pdp_product.id == blank and settings.nawm_product_handle != blank
    assign pdp_product = all_products[settings.nawm_product_handle]
  endif

  assign manual = pdp_product.metafields.nawm.manual_pdf

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.setup.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.setup.heading' | t
  endif
  assign steps = 's1,s2,s3,s4' | split: ','
%}

<section class="nawm-section pdp-setup ctx-dawn" id="instellen">
  <div class="nawm-wrap">
    <div class="pdp-head nawm-reveal">
      {% render 'nawm-eyebrow', text: eyebrow %}
      <h2>{{ heading }}</h2>
    </div>

    <ol class="pdp-setup__steps">
      {%- for key in steps -%}
        {%- liquid
          assign base = 'nawm.pdp.setup.steps.' | append: key
          assign k_time = base | append: '.time'
          assign k_title = base | append: '.title'
          assign k_body = base | append: '.body'
          comment
            Maximaal vijf stappen stagger (v5, B4). Bij zeven stellingen zou de
            laatste 360ms na de eerste beginnen, en dan wacht je op een lijst in
            plaats van hem te lezen.
          endcomment
          assign step = forloop.index0
          if step > 4
            assign step = 4
          endif
          assign delay = step | times: 60
        -%}
        <li class="nawm-card pdp-setup__step nawm-lift nawm-reveal" style="--reveal-delay: {{ delay }}ms;">
          <p class="nawm-mono pdp-setup__time">{{ k_time | t }}</p>
          <h3 class="pdp-setup__title">{{ k_title | t }}</h3>
          <p class="pdp-setup__body">{{ k_body | t }}</p>
        </li>
      {%- endfor -%}
    </ol>

    <div class="pdp-setup__manual nawm-reveal">
      {%- if manual.value != blank -%}
        {% render 'nawm-manual-cta',
          manual: manual,
          extra_class: 'nawm-cta--manual',
          label_key: 'nawm.pdp.setup.manual_cta'
        %}
      {%- else -%}
        <p class="pdp-setup__manual-link">
          {% render 'nawm-verify',
            field: 'manual_pdf',
            note: 'Nederlandstalige handleiding als PDF, te uploaden via Content → Bestanden'
          %}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pdp-setup__steps {
    list-style: none;
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 750px) {
    .pdp-setup__steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pdp-setup__time {
    color: var(--nawm-ember);
    letter-spacing: .12em;
  }

  .pdp-setup__title {
    margin-block-start: var(--sp-2);
  }

  .pdp-setup__body {
    margin-block-start: var(--sp-2);
    max-width: 44ch;
  }

  .pdp-setup__manual {
    margin-block-start: clamp(3rem, 8vw, 4.5rem);
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
    text-align: center;
    padding: var(--sp-4) var(--sp-5);
    border: 1px solid var(--nawm-peach);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--nawm-amber) 14%, var(--nawm-dawn));
  }

  /* De maat van deze knop staat nu als `.nawm-cta--manual` in nawm-base.css,
     zodat de handleidingsknop op alle drie de plekken dezelfde is. */

  .pdp-setup__manual-link {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: var(--ink-day);
    text-decoration: none;
    text-wrap: balance;
  }

  a.pdp-setup__manual-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · PDP instellen",
  "settings": [
    {
      "type": "paragraph",
      "content": "Beantwoordt bezwaar B6: is dit ingewikkeld? De handleiding-link leest uit product.metafields.nawm.manual_pdf."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop"
    }
  ],
  "presets": [
    {
      "name": "NAWM · PDP instellen"
    }
  ]
}
{% endschema %}
