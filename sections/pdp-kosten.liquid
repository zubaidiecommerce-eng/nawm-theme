{% comment %}
  PDP-sectie: het prijsbezwaar in zijn taal. Beantwoordt B4.
  Zie conversiespec v2 §2.2.

  Drie getallen naast elkaar, en dan het bol.com-antwoord dat er tot nu toe
  nergens stond terwijl elke beoordelingskaart naar die listing linkt.

  De drie punten onder "Waarom hier en niet op bol.com" zijn geen marketing:
  het zijn beloften die je waarmaakt of weglaat. Kun je er één niet waarmaken,
  haal hem dan weg — een verantwoording die niet klopt is erger dan geen
  verantwoording.

  De prijs per ochtend is rekenwerk op de werkelijke prijs over een benoemde
  periode. Geen uitspraak over hoe lang het apparaat meegaat, want dat weten we
  niet.
{% endcomment %}

{% liquid
  assign pdp_product = product
  if pdp_product == blank
    assign pdp_product = settings.nawm_product
  endif
  if pdp_product.id == blank and settings.nawm_product_handle != blank
    assign pdp_product = all_products[settings.nawm_product_handle]
  endif

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'nawm.pdp.costs.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'nawm.pdp.costs.heading' | t
  endif

  assign warranty_years = settings.warranty_years | times: 1

  assign per_morning = blank
  if pdp_product.price > 0
    assign cents_per_day = pdp_product.price | divided_by: 365
    assign per_morning = cents_per_day | money
  endif

  assign reasons = 'e1,e2,e3' | split: ','
%}

{%- if pdp_product.price > 0 -%}
  <section class="nawm-section pdp-costs ctx-dawn" id="wat-het-kost">
    <div class="nawm-wrap pdp-costs__inner">
      <div class="pdp-head pdp-head--wide nawm-reveal">
        {% render 'nawm-eyebrow', text: eyebrow %}
        <h2>{{ heading }}</h2>
      </div>

      <dl class="pdp-costs__figures nawm-reveal">
        <div class="pdp-costs__figure">
          <dt class="nawm-mono pdp-costs__value">{{ pdp_product.price | money }}</dt>
          <dd>{{ 'nawm.pdp.costs.once' | t }}</dd>
        </div>

        {%- if per_morning != blank -%}
          <div class="pdp-costs__figure pdp-costs__figure--accent">
            <dt class="nawm-mono pdp-costs__value">{{ per_morning }}</dt>
            <dd>{{ 'nawm.pdp.costs.per_morning' | t }}</dd>
          </div>
        {%- endif -%}

        {%- if warranty_years > 0 -%}
          <div class="pdp-costs__figure">
            <dt class="nawm-mono pdp-costs__value">
              {{- 'nawm.pdp.costs.warranty_value' | t: years: warranty_years -}}
            </dt>
            <dd>{{ 'nawm.pdp.costs.warranty' | t }}</dd>
          </div>
        {%- endif -%}
      </dl>

      <p class="nawm-lede pdp-costs__frame nawm-reveal">{{ 'nawm.pdp.costs.frame' | t }}</p>

      {%- comment -%}
        Het bol.com-antwoord. Zet `toon_prijsverschil_blok` uit zodra een van de
        drie punten niet meer waar is — beter geen verantwoording dan een die
        niet klopt.
      {%- endcomment -%}
      {%- if section.settings.show_elsewhere -%}
        <div class="pdp-costs__elsewhere nawm-reveal">
          <h3 class="pdp-costs__elsewhere-heading">
            {{ 'nawm.pdp.costs.elsewhere_heading' | t }}
          </h3>
          <ul class="pdp-checklist">
            {%- for key in reasons -%}
              {%- assign k = 'nawm.pdp.costs.' | append: key -%}
              <li>{{ k | t }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- comment -%}
        Differentiatie, geen schaarste. Er is geen limited edition en geen
        productielimiet, dus die claim komt hier niet voor.
      {%- endcomment -%}
      {%- if section.settings.show_channels -%}
        <ul class="pdp-costs__channels nawm-reveal">
          <li>{{ 'nawm.differentiation.channels' | t }}</li>
          <li>{{ 'nawm.differentiation.dutch' | t }}</li>
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .pdp-costs__inner {
    max-width: 52rem;
  }

  .pdp-costs__figures {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid;
    gap: var(--sp-3);
  }

  @media (min-width: 600px) {
    .pdp-costs__figures {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pdp-costs__figure {
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--nawm-dawn) 94%, #fff);
    text-align: center;
  }

  /* Het middelste getal is het argument, dus dat krijgt het accent. */
  .pdp-costs__figure--accent {
    border-color: var(--nawm-amber);
    background: color-mix(in oklab, var(--nawm-amber) 16%, var(--nawm-dawn));
  }

  .pdp-costs__value {
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--fg);
  }

  .pdp-costs__figure dd {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--fg-soft);
  }

  .pdp-costs .pdp-costs__frame {
    margin-block-start: clamp(1.5rem, 4vw, 2rem);
    max-width: 48ch;
  }

  .pdp-costs__elsewhere {
    margin-block-start: clamp(2rem, 5vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 1px solid var(--nawm-peach);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--nawm-dawn) 92%, #fff);
  }

  .pdp-costs__elsewhere-heading {
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-h3);
  }

  .pdp-costs__channels {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    font-family: var(--ff-mono);
    font-size: var(--fs-mono);
    letter-spacing: .04em;
    color: var(--fg-soft);
  }

  .pdp-costs__channels li + li::before {
    content: "·";
    margin-inline-end: var(--sp-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NAWM · PDP wat het kost",
  "settings": [
    {
      "type": "paragraph",
      "content": "Beantwoordt bezwaar B4. De drie punten onder \"Waarom hier en niet op bol.com\" zijn beloften die je waarmaakt of weghaalt — een verantwoording die niet klopt is erger dan geen verantwoording."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Kop"
    },
    {
      "type": "checkbox",
      "id": "show_elsewhere",
      "label": "Het bol.com-antwoord tonen",
      "default": true,
      "info": "Zet dit uit zodra je een van de drie punten niet meer waarmaakt."
    },
    {
      "type": "checkbox",
      "id": "show_channels",
      "label": "Verkoopkanalen benoemen",
      "default": true,
      "info": "Differentiatie, geen schaarste. Alleen aan laten zolang je nergens anders verkoopt."
    }
  ],
  "presets": [
    {
      "name": "NAWM · PDP wat het kost"
    }
  ]
}
{% endschema %}
