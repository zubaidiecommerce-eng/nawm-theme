      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Gratis verzending vanaf",
      "info": "Bedrag in hele euro's. Bij dat bedrag verschijnt het label bij de tweede optie."
    }
  ],
  "presets": [{ "name": "NAWM Â· PDP cadeau" }]
}
{% endschema %}
